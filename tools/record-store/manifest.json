{
  "name": "record-store",
  "version": "1.0.0",
  "runtime": "python",
  "execution_type": "process",
  "entrypoint": "app/main.py",
  "description": "작은 문자열 기록을 이름으로 저장하고 다음 호출에서 조회한다. Named text record persistence storage retrieval.",
  "requires_db": true,
  "network": "database",
  "side_effects": false,
  "tables": [
    {
      "name": "records",
      "columns": {
        "record_key": "text",
        "record_value": "text"
      },
      "indexes": [
        [
          "record_key"
        ]
      ]
    }
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "value": {
        "type": "string",
        "maxLength": 10000
      }
    },
    "required": [
      "key"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "key": {
        "type": "string"
      },
      "found": {
        "type": "boolean"
      },
      "value": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "key",
      "found",
      "value"
    ],
    "additionalProperties": false
  },
  "tags": [
    "기록",
    "저장",
    "조회",
    "record",
    "persistence"
  ],
  "examples": [
    {
      "prompt": "기록 greeting 저장 hello",
      "input": {
        "key": "greeting",
        "value": "hello"
      },
      "output": {
        "key": "greeting",
        "found": true,
        "value": "hello"
      }
    },
    {
      "prompt": "기록 missing 조회",
      "input": {
        "key": "missing"
      },
      "output": {
        "key": "missing",
        "found": false,
        "value": null
      }
    }
  ],
  "selection_rules": [
    {
      "pattern": "^기록 (?P<key>[a-z][a-z0-9_]{0,79}) 저장 (?P<value>.{1,1000})$",
      "fields": {
        "key": "string",
        "value": "string"
      }
    },
    {
      "pattern": "^기록 (?P<key>[a-z][a-z0-9_]{0,79}) 조회$",
      "fields": {
        "key": "string"
      }
    }
  ],
  "limits": {
    "timeout_seconds": 30,
    "memory_mb": 256,
    "cpu": 1
  }
}
