{
  "name": "csv-statistics",
  "version": "1.0.0",
  "runtime": "python",
  "execution_type": "process",
  "entrypoint": "app/main.py",
  "description": "CSV 숫자 열의 개수, 결측값 수, 합계, 평균, 최솟값, 최댓값을 Decimal로 계산한다. CSV statistics sum mean min max missing count.",
  "input_schema": {
    "type": "object",
    "properties": {"csv_text": {"type": "string", "maxLength": 500000}, "column": {"type": "string", "minLength": 1}},
    "required": ["csv_text", "column"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "count": {"type": "integer", "minimum": 0}, "missing_count": {"type": "integer", "minimum": 0},
      "sum": {"type": "string"}, "mean": {"type": ["string", "null"]},
      "min": {"type": ["string", "null"]}, "max": {"type": ["string", "null"]}
    },
    "required": ["count", "missing_count", "sum", "mean", "min", "max"],
    "additionalProperties": false
  },
  "tags": ["CSV", "통계", "집계", "평균", "합계", "statistics"],
  "examples": [
    {
      "prompt": "CSV value 열 값 1, 2, 3의 통계를 계산해줘",
      "input": {"csv_text": "value\n1\n2\n3\n", "column": "value"},
      "output": {"count": 3, "missing_count": 0, "sum": "6", "mean": "2", "min": "1", "max": "3"}
    },
    {
      "prompt": "CSV value 열 값 0.1, 0.2의 통계를 계산해줘",
      "input": {"csv_text": "value\n0.1\n0.2\n", "column": "value"},
      "output": {"count": 2, "missing_count": 0, "sum": "0.3", "mean": "0.15", "min": "0.1", "max": "0.2"}
    }
  ],
  "selection_rules": [],
  "requires_db": false,
  "limits": {"timeout_seconds": 30, "memory_mb": 256, "cpu": 1}
}
