{
  "name": "product-comparison",
  "version": "1.1.0",
  "runtime": "python",
  "execution_type": "process",
  "entrypoint": "app/main.py",
  "description": "출처 URL과 확인일이 있는 상품 사양 JSON을 조건 필터하고 비교합니다. 숫자와 단위를 엄격히 검증하고 누락은 unknown으로 보존합니다. 상품 비교 시계 방수 사양 product comparison filter. 웹 검색 및 사실 검증은 수행하지 않습니다. 비교 원본 사양·출처·확인일·결과를 중앙 DB 전용 스키마에 저장하며 compare_id로 재조회하고 목록을 조회합니다.",
  "input_schema": {
    "type": "object",
    "properties": {
      "payload": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "fields": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 30
              },
              "products": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "object"
                }
              },
              "filters": {
                "type": "array",
                "maxItems": 30,
                "items": {
                  "type": "object"
                }
              },
              "sort": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "action": {
                "const": "compare"
              }
            },
            "required": [
              "fields",
              "products"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "get"
              },
              "compare_id": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              }
            },
            "required": [
              "action",
              "compare_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "list"
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              }
            },
            "required": [
              "action"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
