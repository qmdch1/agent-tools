            "items": {
              "type": "object"
            }
          },
          "matched_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "returned_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "excluded": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "compare_id": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        },
        "required": [
