{
  "name": "product-comparison",
  "version": "1.0.0",
  "runtime": "python",
  "execution_type": "process",
  "entrypoint": "app/main.py",
  "description": "출처 URL과 확인일이 있는 상품 사양 JSON을 조건 필터하고 비교합니다. 숫자와 단위를 엄격히 검증하고 누락은 unknown으로 보존합니다. 상품 비교 시계 방수 사양 product comparison filter. 웹 검색 및 사실 검증은 수행하지 않습니다.",
  "input_schema": {
    "type": "object",
    "properties": {
      "payload": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 30
          },
          "products": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object"
            }
          },
          "filters": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object"
            }
          },
          "sort": {
            "type": [
              "object",
              "null"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "fields",
          "products"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "payload"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "fields": {
        "type": "object"
      },
      "products": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object"
        }
      },
      "matched_count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      },
      "returned_count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      },
      "excluded": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "required": [
      "fields",
      "products",
      "matched_count",
      "returned_count",
      "excluded"
    ],
    "additionalProperties": false
  },
  "tags": [
    "상품",
    "비교",
    "시계",
    "방수",
    "사양",
    "comparison",
    "filter"
  ],
  "examples": [
    {
      "prompt": "product-comparison {\"fields\":{\"rating\":{\"type\":\"number\",\"unit\":\"m\"},\"certified\":{\"type\":\"boolean\",\"unit\":null}},\"products\":[{\"id\":\"a\",\"name\":\"Sample A\",\"sources\":[{\"url\":\"https://example.com/a\",\"checked_at\":\"2026-09-08\"}],\"specs\":{\"rating\":{\"value\":200,\"unit\":\"m\"}}}],\"filters\":[{\"field\":\"rating\",\"op\":\"gte\",\"value\":200,\"unit\":\"m\"}]}",
      "input": {
        "payload": {
          "fields": {
            "rating": {
              "type": "number",
              "unit": "m"
            },
            "certified": {
              "type": "boolean",
              "unit": null
            }
          },
          "products": [
            {
              "id": "a",
              "name": "Sample A",
              "sources": [
                {
                  "url": "https://example.com/a",
                  "checked_at": "2026-09-08"
                }
              ],
              "specs": {
                "rating": {
                  "value": 200,
                  "unit": "m"
                }
              }
            }
          ],
          "filters": [
            {
              "field": "rating",
              "op": "gte",
              "value": 200,
              "unit": "m"
            }
          ]
        }
      },
      "output": {
        "fields": {
          "rating": {
            "type": "number",
            "unit": "m"
          },
          "certified": {
            "type": "boolean",
            "unit": null
          }
        },
        "products": [
          {
            "id": "a",
            "name": "Sample A",
            "sources": [
              {
                "url": "https://example.com/a",
                "checked_at": "2026-09-08"
              }
            ],
            "specs": {
              "rating": {
                "value": 200,
                "unit": "m",
                "status": "provided"
              },
              "certified": {
                "value": null,
                "unit": null,
                "status": "unknown"
              }
            }
          }
        ],
        "matched_count": 1,
        "returned_count": 1,
        "excluded": []
      }
    }
  ],
  "selection_rules": [
    {
      "pattern": "^product-comparison\\s+(?P<payload>\\{.*\\})$",
      "fields": {
        "payload": "json"
      }
    }
  ],
  "requires_db": false,
  "network": "none",
  "dependencies": [],
  "limits": {
    "timeout_seconds": 30,
    "memory_mb": 256,
    "cpu": 1
  },
  "generation_tokens_estimated": true
}
